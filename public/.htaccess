<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect legacy static blog pages to the new dynamic React WordPress blog system
  RewriteRule ^blog\.html$ /blog [R=301,L]
  RewriteRule ^blog-single\.html$ /blog [R=301,L]

  # Route friendly URLs to static HTML pages if present
  RewriteRule ^about/?$ about.html [L]
  RewriteRule ^services/?$ services.html [L]
  RewriteRule ^contact/?$ contact.html [L]

  # Don't rewrite files or directories that exist physically
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all other URLs (e.g. /blog, /blog/*, /category/*) to index.html for React Router
  RewriteRule ^ index.html [L]
</IfModule>

# Enable Browser Caching & GZIP Compression for fast cPanel delivery
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
